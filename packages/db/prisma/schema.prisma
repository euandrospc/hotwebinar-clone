generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  twoFactorEnabled Boolean @default(false)
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  twoFactor        TwoFactor?
  sessions         Session[]
  accounts         Account[]
  webinars         Webinar[]
  videos           Video[]
  accountSettings  AccountSettings?
  teamChatMessages LeadChatMessage[] @relation("TeamChatAuthor")
  abExperiments    AbExperiment[]

  @@map("user")
  assignedConversations Lead[] @relation("ConversationAssignee")

}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum WebinarMode {
  UNICO
  JIT
}

enum WebinarStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VideoSource {
  EXTERNAL
  UPLOAD
}

enum VideoStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum EventKind {
  OPTIN
  PAGE_VIEW
  VIDEO_START
  VIDEO_TICK
  VIDEO_END
  OFFER_VIEW
  OFFER_CLICK
  PITCH_REACHED
  RAFFLE_ENTRY
}

enum WaitingTemplate {
  DEFAULT
  WITH_THUMB
  IMMERSIVE
  MINIMAL
  FEATURES
}

enum LogoAlign {
  LEFT
  CENTER
  RIGHT
}

enum AudienceMode {
  NONE
  FIXED
  DYNAMIC
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model AccountSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  defaultLanguage String   @default("pt-BR")
  defaultTimezone String   @default("America/Sao_Paulo")
  brandName       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_settings")
}

model Video {
  id             String      @id @default(cuid())
  ownerId        String
  name           String
  source         VideoSource
  originalUrl    String?
  hlsUrl         String?
  thumbUrl       String?
  customThumbUrl String?
  encKey         String?
  status         VideoStatus @default(QUEUED)
  progress       Int         @default(0)
  durationSec    Int?
  bytes          BigInt?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  webinars       Webinar[]

  @@index([ownerId, createdAt])
  @@map("video")
}

model Webinar {
  id                     String             @id @default(cuid())
  ownerId                String
  videoId                String?
  slug                   String?            @unique
  name                   String             @default("")
  title                  String             @default("")
  language               String             @default("pt-BR")
  status                 WebinarStatus      @default(DRAFT)
  mode                   WebinarMode        @default(UNICO)
  startDate              DateTime?
  endDate                DateTime?
  // UNICO only: repeat the startDate..endDate window at the same local time on
  // recurringDays (0 = Sunday .. 6 = Saturday, in `timezone`).
  recurring              Boolean            @default(false)
  recurringDays          Int[]              @default([])
  timezone               String             @default("America/Sao_Paulo")
  waitingTitle           String             @default("Sala de Espera")
  teamChatName           String             @default("Suporte")
  waitingSubtitle        String             @default("Estamos prestes a começar")
  waitingShowThumb       Boolean            @default(false)
  accessFacilitated      Boolean            @default(false)
  videoSyncWithStart     Boolean            @default(true)
  waitingTemplate        WaitingTemplate    @default(DEFAULT)
  closedGroupUrl         String?
  loginLogoAlign         LogoAlign          @default(CENTER)
  progressEnabled        Boolean            @default(false)
  progressStartPct       Int                @default(50)
  progressBarColor       String             @default("#dc2626")
  progressTextColor      String             @default("#ffffff")
  progressText           String             @default("{pct}% das vagas preenchidas...")
  formFieldOrder         String[]           @default(["name", "email", "phone"])
  logoUrl                String?
  primaryColor           String?
  loginButtonText        String             @default("Entrar")
  loginButtonColor       String             @default("#16a34a")
  nameEnabled            Boolean            @default(true)
  nameRequired           Boolean            @default(true)
  emailEnabled           Boolean            @default(true)
  emailRequired          Boolean            @default(true)
  phoneEnabled           Boolean            @default(true)
  phoneRequired          Boolean            @default(false)
  namePlaceholder        String             @default("Seu nome")
  emailPlaceholder       String             @default("Seu e-mail")
  phonePlaceholder       String             @default("Seu telefone")
  pitchAtSec             Int?
  // Offer (sub-plan D2)
  chatAiEnabled          Boolean @default(false)
  chatAiName             String @default("Assistente")
  chatAiInstructions     String @default("")
  chatAiModel            String @default("gpt-4.1-mini")
  chatInsightLeaseToken  String?
  chatInsightLeaseUntil  DateTime?
  offerName              String             @default("")
  offerTitleStyle          String             @default("highlight")
  offerTitle             String             @default("")
  offerPriceOriginal     String?
  offerPriceFinal        String?
  offerButtonText        String             @default("Quero aproveitar")
  offerButtonColor       String             @default("#dc2626")
  offerImageDesktopUrl   String?
  offerImageMobileUrl    String?
  offerShowAtSec         Int?
  offerHideAtSec         Int?
  offerLink              String?
  offerPassUtms          Boolean            @default(false)
  offerDisabled          Boolean            @default(false)
  offerSameWindow        Boolean            @default(false)
  offerRaffleEnabled     Boolean            @default(false)
  offerRaffleAtSec       Int?
  offerRaffleNumber      String?
  webhookOnOfferView     Boolean            @default(false)
  webhookOnOfferClick    Boolean            @default(false)
  webhookOnRaffleEntry   Boolean            @default(false)
  webhookOnSale          Boolean            @default(false)
  webhookUrl             String?
  webhookOnOptin         Boolean            @default(false)
  webhookOnEnter         Boolean            @default(false)
  webhookOnPitchReached  Boolean            @default(false)
  webhookOnPermanence    Boolean            @default(false)
  webhookOnLeave         Boolean            @default(false)
  permanenceThresholdSec Int                @default(300)
  audienceMode           AudienceMode       @default(NONE)
  audienceMin            Int                @default(50)
  audienceMax            Int                @default(500)
  audienceLiveBadge      Boolean            @default(true)
  salesWebhookSecret     String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  owner                  User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  video                  Video?             @relation(fields: [videoId], references: [id], onDelete: SetNull)
  chatMessages           ChatMessage[]
  leads                  Lead[]
  events                 Event[]
  leadChatMessages       LeadChatMessage[]
  webhookDeliveries      WebhookDelivery[]
  saleNotifications      SaleNotification[]
  audienceSamples        AudienceSample[]
  sales                  Sale[]
  abExperimentsAsA        AbExperiment[] @relation("AbWebinarA")
  abExperimentsAsB        AbExperiment[] @relation("AbWebinarB")

  @@index([ownerId, status])
  @@map("webinar")
}

model ChatMessage {
  id         String  @id @default(cuid())
  webinarId  String
  authorName String
  text       String
  showAtSec  Int
  isOwner    Boolean @default(false)
  webinar    Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, showAtSec])
  @@map("chat_message")
}

model Lead {
  id                String            @id @default(cuid())
  webinarId         String
  name              String
  email             String
  phone             String?
  ip                String?
  userAgent         String?
  device            String?
  country           String?
  city              String?
  region            String?
  lat               Float?
  lng               Float?
  watchedSec        Int               @default(0)
  reachedPitch      Boolean           @default(false)
  ctaClicks         Int               @default(0)
  sessionStart      DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())
  enterFired        Boolean           @default(false)
  pitchFired        Boolean           @default(false)
  permanenceFired   Boolean           @default(false)
  leaveFired        Boolean           @default(false)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmTerm           String?
  utmContent        String?
  assignedAttendantId String?
  assignedAttendant User? @relation("ConversationAssignee", fields: [assignedAttendantId], references: [id], onDelete: SetNull)
  attendanceClosedAt DateTime?
  aiPaused          Boolean @default(false)
  chatVersion       Int @default(0)
  aiPendingMessageId String?
  aiLeaseToken      String?
  aiLeaseUntil      DateTime?
  aiAttempts        Int @default(0)
  aiNextAttemptAt   DateTime?
  aiError           String?
  webinar           Webinar           @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  events            Event[]
  leadChatMessages  LeadChatMessage[]
  webhookDeliveries WebhookDelivery[]
  sales             Sale[]
  abAssignments     AbAssignment[]

  @@unique([webinarId, email])
  @@index([webinarId, sessionStart])
  @@index([ip])
  @@map("lead")
}

enum AbExperimentMode {
  OBSERVATIONAL
  RANDOMIZED
}

enum AbExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum AbExperimentMetric {
  PURCHASE
  OFFER_CLICK
  PITCH_REACHED
}

enum AbVariant {
  A
  B
}

model AbExperiment {
  id                     String             @id @default(cuid())
  ownerId                String
  name                   String
  hypothesis             String             @default("")
  testVariable           String             @default("FULL_WEBINAR")
  variantADescription    String             @default("")
  variantBDescription    String             @default("")
  mode                   AbExperimentMode
  observationUnit        String             @default("LEAD")
  status                 AbExperimentStatus @default(DRAFT)
  metric                 AbExperimentMetric @default(PURCHASE)
  webinarAId             String
  webinarBId             String
  baselineRate           Float              @default(0.05)
  minimumDetectableLift  Float              @default(0.2)
  sampleSizePerVariant   Int
  durationDays           Int                @default(14)
  conversionWindowHours Int                @default(72)
  startedAt              DateTime?
  endsAt                 DateTime?
  completedAt            DateTime?
  interruptedAt          DateTime?
  webinarAFingerprint    String?
  webinarBFingerprint    String?
  webinarASnapshot       Json?
  webinarBSnapshot       Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  owner                  User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  webinarA               Webinar            @relation("AbWebinarA", fields: [webinarAId], references: [id], onDelete: Restrict)
  webinarB               Webinar            @relation("AbWebinarB", fields: [webinarBId], references: [id], onDelete: Restrict)
  assignments            AbAssignment[]

  @@index([ownerId, createdAt])
  @@map("ab_experiment")
}

model AbAssignment {
  id           String       @id @default(cuid())
  experimentId String
  visitorId    String
  variant      AbVariant
  leadId       String?
  createdAt    DateTime     @default(now())
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  device       String?
  experiment   AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([experimentId, visitorId])
  @@index([experimentId, createdAt])
  @@index([leadId])
  @@map("ab_assignment")
}

enum GeoIpStatus {
  PENDING
  SUCCESS
  FAILED
}

// A durable job and a shared cache: one provider lookup per normalized IP.
model GeoIpLookup {
  ip            String      @id
  status        GeoIpStatus @default(PENDING)
  priority      Int         @default(0)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  leaseToken    String?
  leaseUntil    DateTime?
  country       String?
  region        String?
  city          String?
  lat           Float?
  lng           Float?
  lastError     String?
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, priority, nextAttemptAt])
  @@map("geo_ip_lookup")
}

// The provider's pacing/cooldown is shared by all application instances.
model GeoIpProviderState {
  id            String   @id
  nextRequestAt DateTime @default(now())
  leaseToken    String?
  leaseUntil    DateTime?

  @@map("geo_ip_provider_state")
}

model Event {
  id        String    @id @default(cuid())
  webinarId String
  leadId    String?
  kind      EventKind
  videoSec  Int?
  ctaId     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  webinar   Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([webinarId, kind, createdAt])
  @@index([leadId, kind])
  @@map("event")
}

model LeadChatMessage {
  id           String   @id @default(cuid())
  leadId       String
  webinarId    String
  text         String
  videoSec     Int?
  sender       String   @default("lead")
  aiAgentName  String?
  authorUserId String?
  clientMessageId String?
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  webinar      Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  authorUser   User?    @relation("TeamChatAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  analysis     LeadChatMessageAnalysis?

  @@index([webinarId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([leadId, createdAt])
  @@unique([leadId, clientMessageId])
  @@map("lead_chat_message")
}

model LeadChatMessageAnalysis {
  messageId  String   @id
  version    String
  model      String
  objections String[] @default([])
  questions  String[] @default([])
  analyzedAt DateTime @default(now())
  message    LeadChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([version, model])
  @@map("lead_chat_message_analysis")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  webinarId      String
  leadId         String?
  event          String
  url            String
  payload        Json
  attempt        Int                   @default(0)
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  webinar        Webinar               @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  lead           Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([webinarId, status, createdAt])
  @@map("webhook_delivery")
}

model SaleNotification {
  id          String   @id @default(cuid())
  webinarId   String
  showAtSec   Int
  buyerName   String
  productName String
  price       String?
  createdAt   DateTime @default(now())
  webinar     Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, showAtSec])
  @@map("sale_notification")
}

model Sale {
  id          String   @id @default(cuid())
  webinarId   String?
  leadId      String?
  externalId  String   @unique
  amount      Int
  currency    String   @default("BRL")
  productName String?
  buyerEmail  String?
  buyerName   String?
  source      String?
  payload     Json?
  createdAt   DateTime @default(now())
  webinar     Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([webinarId, createdAt])
  @@index([leadId])
  @@map("sale")
}

model AudienceSample {
  webinarId String
  sampledAt DateTime
  observedAt DateTime @default(now())
  online Int
  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@id([webinarId, sampledAt])
  @@index([webinarId, observedAt])
  @@map("audience_sample")
}


model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  userId      String @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}
