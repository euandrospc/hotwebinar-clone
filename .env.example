# ============ Web ============
DATABASE_URL="postgresql://hotwebinar:hotwebinar@localhost:5432/hotwebinar?schema=public"

# Better Auth
# NOTE: the literal value below is rejected by apps/web/src/lib/auth.ts at startup.
# Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-32-chars-minimum-please"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Seed admin (run pnpm seed once)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-min-12-chars"
SEED_ADMIN_NAME="Admin"

# ============ Scraper ============
# Scraper target
TARGET_BASE_URL="https://your-original-platform.com"
TARGET_LOGIN_EMAIL=""
TARGET_LOGIN_PASSWORD=""

# Storage video (S3/MinIO/local)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Scraper extras (all optional)
TARGET_LOGIN_PATH=/login
SIDEBAR_SELECTOR="aside a, nav a"
CRAWL_START_ROUTE=/dashboard
MAX_PAGES=200
MAX_DEPTH=3
CRAWL_DELAY_MS=500
BODY_MAX_CHARS=200000
